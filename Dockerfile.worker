# Dockerfile for the vLLM Worker
# Using PyTorch base with CUDA (lighter than full vLLM image)
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-devel

WORKDIR /app

# Install build essentials and fix CUDA library links
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    # Create symlink for libcuda.so (needed by Triton)
    && ln -sf /usr/local/cuda/compat/libcuda.so.1 /usr/local/cuda/lib64/libcuda.so \
    && ldconfig

# Install vLLM and Redis (no flash-attn to keep it light)
RUN pip install --no-cache-dir \
    vllm>=0.4.0 \
    redis>=5.0.0

# Copy application code
COPY src/ ./src/

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Force vLLM v0 engine (more stable on T4 GPUs)
ENV VLLM_USE_V1=0

# Default model configuration
ENV MODEL_NAME="Qwen/Qwen3-1.7B"
ENV MODEL_MAX_LENGTH="4096"
ENV GPU_MEMORY_UTILIZATION="0.85"

# Run the worker
CMD ["python", "src/worker.py"]
